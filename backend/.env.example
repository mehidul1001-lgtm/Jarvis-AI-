# JARVIS AI backend configuration.
# Copy to .env and adjust. All variables use the JARVIS_ prefix.

# development | test | production
JARVIS_ENVIRONMENT=development

# PostgreSQL connection (asyncpg driver)
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@localhost:5432/jarvis

# REQUIRED in production. Generate:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
JARVIS_JWT_SECRET_KEY=

# REQUIRED in production. Generate:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
JARVIS_ENCRYPTION_KEY=

# Token lifetimes
JARVIS_ACCESS_TOKEN_EXPIRE_MINUTES=15
JARVIS_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed browser origins
JARVIS_CORS_ORIGINS=http://localhost:5173

# Rate limiting
JARVIS_RATE_LIMIT_ENABLED=true
JARVIS_RATE_LIMIT_REQUESTS=120
JARVIS_RATE_LIMIT_WINDOW_SECONDS=60
JARVIS_RATE_LIMIT_AUTH_REQUESTS=10
JARVIS_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Logging: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# JARVIS AI backend configuration.
# Copy to .env and adjust. All variables use the JARVIS_ prefix.

# development | test | production
JARVIS_ENVIRONMENT=development

# PostgreSQL connection (asyncpg driver)
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_dev_password@localhost:5432/jarvis

# REQUIRED in production. Generate:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
JARVIS_JWT_SECRET_KEY=

# REQUIRED in production. Generate:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
JARVIS_ENCRYPTION_KEY=

# Token lifetimes
JARVIS_ACCESS_TOKEN_EXPIRE_MINUTES=15
JARVIS_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed browser origins
JARVIS_CORS_ORIGINS=http://localhost:5173

# Rate limiting
JARVIS_RATE_LIMIT_ENABLED=true
JARVIS_RATE_LIMIT_REQUESTS=120
JARVIS_RATE_LIMIT_WINDOW_SECONDS=60
JARVIS_RATE_LIMIT_AUTH_REQUESTS=10
JARVIS_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Logging: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# Optional: auto-connect one Amazon account on startup instead of using
# POST /api/v1/amazon/credentials. Leave all blank to skip - these are the
# only settings in this file that do NOT use the JARVIS_ prefix, so the
# same values also work for scripts/validate_amazon_live.py.
# See docs/amazon-validation.md for how to obtain them.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_BOOTSTRAP_USER_EMAIL=
# AMAZON_REGION=NA
# AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# AMAZON_CREDENTIAL_LABEL=Primary Store
